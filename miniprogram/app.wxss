page{background:#11151c;color:#e9eff7;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.55}
.page{padding:32rpx 30rpx 44rpx;box-sizing:border-box}.eyebrow{font-size:22rpx;color:#8794a6;letter-spacing:3rpx}.title{font-size:42rpx;line-height:1.25;font-weight:650;margin:10rpx 0 26rpx}.section-title{font-size:30rpx;font-weight:600;margin:34rpx 0 20rpx}.sub{font-size:24rpx;color:#9aa8ba}.muted{color:#8794a6}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.card{background:#1a212d;border:1rpx solid #2b3443;border-radius:22rpx;padding:26rpx;margin-bottom:20rpx;box-sizing:border-box}.hero{background:linear-gradient(130deg,#203d40,#1a2732);border:1rpx solid #365a59;padding:30rpx;border-radius:26rpx;margin-bottom:26rpx}.hero-title{font-size:36rpx;font-weight:600}.pill{font-size:22rpx;padding:6rpx 16rpx;border-radius:99rpx;background:#243c3b;color:#61e0c4;white-space:nowrap}.pill.warn{color:#f2bf75;background:#413728}.pill.bad{color:#ff9a9f;background:#432d35}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.metric{margin-top:24rpx;margin-bottom:24rpx}.value{font-size:54rpx;line-height:1.25;font-weight:650;letter-spacing:-2rpx}.unit{font-size:24rpx;margin-left:8rpx;color:#a7b7c7}.metric-label{font-size:24rpx;color:#9eacbf;margin-bottom:10rpx}.dim{opacity:.62}.notice{padding:22rpx;border-radius:16rpx;background:#302b25;color:#e9c792;font-size:25rpx;margin-bottom:22rpx}.error{background:#3c2930;color:#ffc1c4}.empty{padding:70rpx 24rpx;text-align:center;color:#98a7b8}.empty-title{color:#dee6ef;font-size:32rpx;margin-bottom:16rpx}.link{color:#5adcc3}.btn{background:#50dfc5;color:#10221f;border-radius:16rpx;border:0;font-size:29rpx;font-weight:600;margin:24rpx 0;padding:6rpx 18rpx}.btn::after{border:0}.btn.secondary{background:#263342;color:#d9e6f4}.filters{display:flex;gap:14rpx;margin-bottom:22rpx;flex-wrap:wrap}.filter{padding:13rpx 22rpx;border:1rpx solid #364254;border-radius:14rpx;font-size:25rpx;color:#a6b4c7}.filter.active{background:#244440;color:#63e5cc;border-color:#408275}.event{display:flex;gap:22rpx}.event-icon{width:16rpx;height:16rpx;border-radius:50%;background:#5adfc5;margin-top:14rpx;flex-shrink:0}.event-icon.bad{background:#f58e96}.event-body{flex:1;min-width:0}.event-title{font-size:29rpx;font-weight:550}.divider{height:1rpx;background:#2b3443;margin:24rpx 0}.kv{padding:13rpx 0;display:flex;justify-content:space-between;gap:24rpx}.kv text:last-child{text-align:right;word-break:break-all}.input{background:#111924;border:1rpx solid #3c4a5d;border-radius:12rpx;padding:22rpx;margin:16rpx 0;height:50rpx;line-height:50rpx}.bullet{margin:18rpx 0;color:#c5d0df}.footer-note{font-size:23rpx;color:#8494a7;line-height:1.65;margin-top:26rpx}.arrow{color:#8496aa;margin-left:12rpx}.time{font-size:23rpx;color:#97a9bc;margin-top:12rpx}.tag{font-size:22rpx;color:#f1bf78;margin:14rpx 0}.small-value{font-size:36rpx;font-weight:600}.spaced{margin-top:24rpx}
