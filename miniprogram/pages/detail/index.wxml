<view class="page"><view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{event}}"><view class="eyebrow">{{event.name}} · 开机编号 {{event.boot}}</view><view class="title">{{event.title}}</view><view class="sub">{{event.timeText}} · {{event.timeLabel}}</view><view class="sub spaced">{{event.source==='heartbeat'?'中断前最后上报时，主站已运行':'事件发生时，主站已运行'}} {{event.uptimeText}}</view><view class="section-title">我们已经知道什么</view><view class="card"><text class="pill warn">{{event.diagnosis.confidence}}</text><view wx:for="{{event.diagnosis.observations}}" wx:key="*this" class="bullet">{{item}}</view><view class="divider"/><view class="sub">{{event.diagnosis.limitation}}</view></view><view class="section-title">事件前最后保存的读数</view><view class="filters" wx:if="{{event.node===0}}"><view class="filter {{chartNode===1?'active':''}}" data-node="1" bindtap="selectNode">星火从站</view><view class="filter {{chartNode===2?'active':''}}" data-node="2" bindtap="selectNode">龙芯从站</view></view><view class="card"><view wx:if="{{event.last}}"><view class="sub">保存于 {{event.snapshotTime}}</view><view class="grid spaced" wx:if="{{chartNode===1}}"><view><view class="metric-label">温度</view><text class="small-value">{{event.last.temperature}} ℃</text></view><view><view class="metric-label">湿度</view><text class="small-value">{{event.last.humidity}} %</text></view></view><view class="grid spaced" wx:else><view><view class="metric-label">CPU</view><text class="small-value">{{event.last.cpu}} %</text></view><view><view class="metric-label">已用内存</view><text class="small-value">{{event.last.memory}} MB</text></view></view></view><view wx:else class="sub">这条事件之前，没有保存到可用的云端读数。</view></view><view class="card"><view class="row"><text>事件前后变化</text><text class="sub">{{event.available_points}} 个已保存点</text></view><metric-chart points="{{event.points}}" node="{{chartNode}}" field="{{metric}}" unit="{{unit}}"/><view class="filters" wx:if="{{chartNode===1}}"><view class="filter {{metric==='temperature'?'active':''}}" data-metric="temperature" data-unit="℃" bindtap="selectMetric">温度</view><view class="filter {{metric==='humidity'?'active':''}}" data-metric="humidity" data-unit="%" bindtap="selectMetric">湿度</view></view><view class="filters" wx:else><view class="filter {{metric==='cpu'?'active':''}}" data-metric="cpu" data-unit="%" bindtap="selectMetric">CPU</view><view class="filter {{metric==='memory_mb'?'active':''}}" data-metric="memory_mb" data-unit="MB" bindtap="selectMetric">内存</view></view><view class="sub">{{event.sample_note}}</view></view><view class="section-title">建议接下来检查</view><view class="card"><view wx:for="{{event.diagnosis.checks}}" wx:key="*this" class="bullet">{{index+1}}. {{item}}</view></view><view class="footer-note">{{event.time_note}}。云端接收于 {{event.receiveText}}。设备事件的发生时间为推算值，可能受网络延迟影响。</view></view></view>
